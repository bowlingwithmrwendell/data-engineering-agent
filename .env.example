# Copy to .env and fill in. Never commit .env.

# --- Claude -------------------------------------------------------------------
# Optional: enables "Ask in plain English". The builder, catalog, sandbox and
# approvals all work without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Demo data ------------------------------------------------------------------
AS_OF_DATE=2026-10-20          # the fictional estate is frozen at this date

# --- Code sandbox -----------------------------------------------------------------
SANDBOX_TIMEOUT_SECONDS=5      # hard stop for one test run
SANDBOX_PREVIEW_ROWS=25
SANDBOX_MAX_OUTPUT_ROWS=5000

# --- Kill switch --------------------------------------------------------------
# false = every model call is refused (fails closed). Everything else keeps working.
AI_ENABLED=true
# Set to enable the runtime kill switch on /governance (header X-Admin-Token).
ADMIN_TOKEN=

# --- Human review gate ----------------------------------------------------------
# Optional: if set, every review and deployment decision must send header X-Reviewer-Token.
REVIEWER_TOKEN=

# --- Limiter ------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=5        # AI requests per visitor per minute
DAILY_CAP_PER_VISITOR=25       # AI requests per visitor per UTC day
DAILY_CAP_GLOBAL=200           # AI requests, all visitors, per UTC day
DAILY_TOKEN_BUDGET=400000      # input + output tokens, all visitors, per UTC day
MAX_TOKENS=1500                # max_tokens per agent model call
MAX_AGENT_TURNS=8              # tool round trips per request
MAX_REQUEST_BYTES=32768        # largest request body accepted (413 above this)
MAX_QUESTION_CHARS=1000        # longest request accepted (422 above this)
# 0 = use the direct client address; 1 = behind one proxy (Render)
TRUSTED_PROXY_HOPS=0
# Salt for hashing visitor addresses (raw IPs are never stored). Change it in production.
VISITOR_SALT=change-me
